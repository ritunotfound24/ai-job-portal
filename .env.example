# SQLite file used by Prisma (switch provider to "postgresql" in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: an OpenAI-compatible endpoint for LLM-written resume feedback.
# Leave empty to use the built-in rule-based feedback only.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
